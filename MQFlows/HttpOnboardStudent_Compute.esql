

CREATE COMPUTE MODULE HttpOnboardStudent_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		-- 1. Copy essential MQ MD properties (tells MQ this is an XML message)
        SET OutputRoot.Properties.MessageDomain = 'XMLNSC';
        
        -- 2. Copy ONLY the XMLNSC tree data from Input to Output
        -- This completely ignores and drops the HTTPInputHeader
        SET OutputRoot.XMLNSC = InputRoot.XMLNSC;
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
