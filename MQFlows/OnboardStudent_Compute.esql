

CREATE COMPUTE MODULE OnboardStudent_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- 1. Set Email Header Information (Including CC)
		SET OutputRoot.EmailOutputHeader.To = InputRoot.XMLNSC.student.studentEmail;
		--SET OutputRoot.EmailOutputHeader.From = 'testsender@example.com';
		SET OutputRoot.EmailOutputHeader.Subject = 'Testing Email sending from IBM ACE';
		
		-- Option A: Single CC recipient
		--SET OutputRoot.EmailOutputHeader.Cc = 'test@gmail.com';
		
		-- Option B: Multiple CC recipients (Separate them with a comma)
		-- SET OutputRoot.EmailOutputHeader.Cc = 'cc_user1@example.com, cc_user2@example.com';
		
		-- 2. Set SMTP Server via Local Environment
		--SET OutputLocalEnvironment.Destination.Email.SMTPServer = '://example.com';
		
		-- 3. Set Email Body Text (as BLOB)
		DECLARE emailBody CHARACTER;
		SET emailBody=InputRoot.XMLNSC.student.firtName||' '||InputRoot.XMLNSC.student.lastName||CAST(X'0D0A' AS CHARACTER CCSID 1208)||'Welcome to school';
		SET OutputRoot.BLOB.BLOB = CAST(emailBody AS BLOB CCSID 1208);

		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
