BROKER SCHEMA sschema


CREATE COMPUTE MODULE Prepare_Response_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		--Creating a json response
       
        SET OutputRoot.JSON.Data.ErrorDetails. Code =  Environment.Variables.Error.Code;
        SET OutputRoot.JSON.Data.ErrorDetails.Description = 'An internal integration error occured at node : '||Environment.Variables.Error.Label;
        
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
